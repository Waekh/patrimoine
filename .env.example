# --- Base de données -------------------------------------------------------
# Locale : postgres://postgres:postgres@127.0.0.1:5432/patrimoine_dev
# Supabase (application) : URL "Transaction pooler" du projet, port 6543.
# Supabase (migrations)  : connexion directe port 5432 (IPv6), ou Session pooler si reseau IPv4.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/patrimoine_dev
# Facultatif : taille du pool de connexions (5 par défaut, adapté au serverless).
DATABASE_POOL_MAX=5

# --- Authentification ------------------------------------------------------
# local    : comptes stockés dans la base locale (développement / tests uniquement, refusé en production)
# supabase : Supabase Auth (production)
AUTH_PROVIDER=local
# Secret HMAC des sessions de l'adaptateur local (32+ caractères aléatoires)
LOCAL_AUTH_SECRET=change-me-with-a-long-random-string-for-dev-only

# Supabase (requis si AUTH_PROVIDER=supabase)
# L'application n'utilise jamais Supabase dans le navigateur : le prefixe NEXT_PUBLIC_
# n'est pas necessaire. Les noms NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY /
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY restent acceptes.
SUPABASE_URL=
# Accepte l'ancienne cle "anon" comme la nouvelle cle "publishable" (sb_publishable_...).
SUPABASE_ANON_KEY=
# Optionnelle, serveur uniquement, jamais côté client. Non utilisée par le MVP.
SUPABASE_SERVICE_ROLE_KEY=

# --- Données de marché -----------------------------------------------------
# mock : fournisseur simulé (aucune donnée réelle)
MARKET_DATA_PROVIDER=mock

# --- Application -----------------------------------------------------------
# Sur Vercel, déduit automatiquement de l'URL du déploiement si absente.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# development | test | preview | production (informatif, distinct de NODE_ENV)
APP_ENV=development
